# Secrets
**/.env
**/.env.*
!**/.env.example

# Python
**/__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# IDE
.cursor/
.vscode/

# Local model weights / train runs / merge scratch
# (no trailing slash: also ignore symlinks like model -> /root/autodl-tmp/model)
/model
/train_outputs
/merged

# Eval results (keep configs + README/analysis tracked; ignore metrics/predictions/tables)
/eval_output/*
!/eval_output/README.md
!/eval_output/evaluation_analysis.md
!/eval_output/configs/
!/eval_output/configs/**

# Oversized local dumps (GitHub 100MB limit)
final_reward_data.json
**/final_reward_data.json
