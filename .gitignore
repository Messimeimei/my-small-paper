# Secrets
**/.env
**/.env.*
!**/.env.example

# Python
**/__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# IDE
.cursor/
.vscode/

# Local model weights / train runs / merge scratch
# (no trailing slash: also ignore symlinks like model -> /root/autodl-tmp/model)
/model
/train_outputs
/merged

# Eval results (keep configs + README tracked; ignore metrics/predictions/tables)
/evaloutput/*
!/evaloutput/README.md
!/evaloutput/configs/
!/evaloutput/configs/**

# Oversized local dumps (GitHub 100MB limit)
final_reward_data.json
**/final_reward_data.json
